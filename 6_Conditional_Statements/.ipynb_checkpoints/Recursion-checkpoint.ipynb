    "def write_text(text, n):\n",
    "    print(n, text)\n",
    "    \n",
    "    if n<=0:\n",
    "        print(\"_________END OF PROGRAM_________\")\n",
    "        return\n",
    "    else:\n",
    "        write_text(text, n-1)"
   ]
